{
  "name": "vcam",
  "version": "0.2.0",
  "description": "iPhone camera for Windows, connected by QR",
  "author": "prodbyEDDY",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:ui": "node web/node_modules/vite/bin/vite.js build --config web/vite.desktop.ts",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": { "electron": "^41.0.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "dev.prodbyeddy.vcam",
    "beforePack": "scripts/before-pack.cjs",
    "productName": "VCam",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "package.json"],
    "extraResources": [{ "from": "native/bin", "to": "native", "filter": ["*.dll", "*.exe"] }, { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }],
    "win": { "target": ["nsis"], "artifactName": "VCam-Setup-${version}-${arch}.${ext}", "icon": "desktop/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "perMachine": true, "allowToChangeInstallationDirectory": true, "include": "desktop/installer.nsh", "deleteAppDataOnUninstall": false }
  }
}
